{
  "transient_prompt": {
    "template": " ~#@❯ ",
    "foreground": "#a61c1c",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "template": "<#9809ff>\u250f[</>{{ if .WSL }} \uf17c on {{ end }}\ue8e5 <#9809ff>]</>",
          "foreground": "#ffff66",
          "type": "os",
          "style": "plain"
        },
        {
          "template": "<#9500ff>--[</>{{ if ne .Env.POSH_SESSION_DEFAULT_USER .UserName }}<#ffff66> \udb84\uddd0 {{ .UserName }}</> <#9500ff>\udb81\udf68</>{{ end }} <#ffff66>{{ .HostName }} </><#9500ff>]--</>",
          "foreground": "#4e515e",
          "type": "session",
          "style": "plain"
        },
        {
          "template": " \uf0e7<#7a7a7a> \ue0b1</>",
          "foreground": "#0a0a0a",
          "type": "root",
          "style": "plain"
        },
        {
          "options": {
            "folder_icon": "<#B5B2C2>\ue5fe </>",
            "folder_separator_icon": "<#B5B2C2>\ue0bf </>",
            "home_icon": "\uf015",
            "style": "agnoster_short"
          },
          "template": "<#9500ff> -- </><#f2f200> \ue5ff </>{{ .Path }} ",
          "foreground": "#0a0a0a",
          "background": "#9500ff",
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0"
        },
        {
          "trailing_diamond": "\ue0b0",
          "template": "  ",
          "foreground": "#fafafa",
          "background": "#a61c1c",
          "type": "text",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "<#7a7a7a>\ue0b1 </>{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<#E84855> \uf044 {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#2FDA4E> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#ffeb3b",
          "background": "#a61c1c",
          "type": "git",
          "style": "diamond",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffeb3b{{ end }}",
            "{{ if gt .Ahead 0 }}#2EC4B6{{ end }}",
            "{{ if gt .Behind 0 }}#8A4FFF{{ end }}"
          ]
        },
        {
          "leading_diamond": "\ue0b2",
          "template": "  ",
          "foreground": "#fafafa",
          "background": "#a61c1c",
          "type": "text",
          "style": "diamond"
        },
        {
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}<#7a7a7a> \ue0b3</>",
          "foreground": "#6CA35E",
          "background": "#a61c1c",
          "type": "node",
          "style": "diamond"
        },
        {
          "template": "\ue235{{ if .Error }}{{ .Error }} {{ else }}{{ if .Venv }}{{ .Venv }}{{ end }}{{ .Full }}{{ end }}<#7a7a7a>\ue0b3</>",
          "foreground": "#96E072",
          "background": "#a61c1c",
          "type": "python",
          "style": "diamond"
        },
        {
          "template": " \ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}<#7a7a7a> \ue0b3</>",
          "foreground": "#3891A6",
          "background": "#a61c1c",
          "type": "dotnet",
          "style": "diamond"
        },
        {
          "options": {
            "time_format": "15:04:05"
          },
          "trailing_diamond": "\u2593\ue0c6",
          "template": " {{ .CurrentDate | date .Format }}<#007ACC> \ue641 </>",
          "foreground": "#fafafa",
          "background": "#a61c1c",
          "type": "time",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "<#0a0a0a>~</>#@<#ffff66>❯</>",
          "foreground": "#9809ff",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "template": " ❮ ",
          "foreground": "#a61c1c",
          "type": "text",
          "style": "plain"
        },
        {
          "options": {
            "style": "roundrock",
            "threshold": 500
          },
          "template": " {{ .FormattedMs }}<#fafafa> \uf252 </>",
          "foreground": "#FFCE5C",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": " \uea9f {{ if gt .Code 0 }}{{ .Code }}{{ end }} ",
          "foreground": "#9FD356",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E84855{{ end }}"
          ]
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
